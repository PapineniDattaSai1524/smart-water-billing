# Copy to .env and fill in real values before running `docker compose up`.
# .env is gitignored -- never commit real secrets.

# --- Database ---
DB_NAME=smart_water_db
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_HOST_PORT=5432

# --- Backend / JWT ---
# Required. Generate with: openssl rand -hex 32
# Must be unique per environment and at least 32 bytes -- see
# backend/src/main/java/.../config/JwtSecretStartupValidator.java, which
# refuses to boot in the 'prod' profile if this is left at its dev default.
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
# Use 'dev' for local/demo runs (matches the checked-in defaults), 'prod' to
# enable the JWT secret startup guardrail before a real deployment.
SPRING_PROFILES_ACTIVE=dev
BACKEND_HOST_PORT=8080

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# --- SMTP (for alert/notification emails) ---
# Leave MAIL_USERNAME/MAIL_PASSWORD blank to disable outgoing mail in dev.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@smartwaterbilling.local

# --- Alert engine ---
ALERT_ENGINE_ENABLED=true
ALERT_EMAIL_ENABLED=true

# --- Frontend ---
# Baked into the frontend bundle at build time (Vite inlines env vars).
VITE_API_BASE_URL=http://localhost:8080/api/v1
FRONTEND_HOST_PORT=8081
