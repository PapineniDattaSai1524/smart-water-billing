# Copy this file to backend/.env (or export these as real environment variables /
# secrets in your deployment platform) and fill in real values.
# NEVER commit a file containing real secrets -- backend/.env is already git-ignored.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/smart_water_db
DB_USERNAME=postgres
DB_PASSWORD=

# --- JWT ---
# Generate your own random secret for anything beyond local dev; do not reuse the
# checked-in default in application.properties for staging/production.
JWT_SECRET=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Forgot / Reset Password ---
# Base URL of the frontend, used to build the link emailed on a password reset request.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# --- Email (SMTP) ---
# Required for the Week 5-6 Alert & Notification Engine and bill-email feature to
# actually send mail. Leave unset to run with email notifications disabled -- the
# app degrades gracefully (see EmailNotificationService) rather than failing to start.
# If using Gmail: generate an App Password at https://myaccount.google.com/apppasswords
# -- never use your real account password here.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@yourdomain.com
